# Paths in kindling.manifest that should NOT be copied to consumer roots on init/sync.
# Exact relative paths only; no globs.
#
# Files listed here stay in .kindling/ only — they are not materialized at the
# consumer repo root. Used by init-kindling.sh / sync-kindling.sh.

# Kindling repo identity and maintainer docs — stay in .kindling/ only
KINDLING_REPO
CHANGELOG.md
INIT.MD
README.md
kindling.manifest
.syncignore
docs/kindling-MAINTAINERS.md
docs/kindling-consumer-layout.md
.claude/rules/kindling-repo-maintenance.md
.cursor/rules/kindling-repo-maintenance.mdc
